#!/bin/sh
# DSHKer-bundled pnpm entry: runs the Launcher's pinned pnpm distribution on its
# standalone Node binary. The pnpm.mjs package sits next to this
# bin directory (../pnpm/bin/pnpm.mjs), so the shim resolves it relative to
# itself and works identically in staged and packaged layouts.
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec "$SCRIPT_DIR/node" --expose-internals "$SCRIPT_DIR/../pnpm/bin/pnpm.mjs" "$@"
