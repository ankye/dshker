# Copy to .env.local for local development. Do not commit real secrets.
APP_ENV=development
STATLOG_ENDPOINT=http://127.0.0.1:8080/v1/statlog/report
STATLOG_PROJECT_KEY=demo
STATLOG_INGEST_TOKEN=
VITE_ASSET_SERVICE_URL=http://127.0.0.1:4177
VITE_ASSET_SERVICE_TOKEN=

# Integration tests (npm run test:integration).
#
# Both artefacts live outside this repository, so the Go integration suite fails
# rather than skipping when they are absent. Leave these blank to accept the
# documented defaults below; set them when your checkouts live elsewhere.
#
# The coordinator server binary the peer tests dial. Build with:
#   cd <coordinator-checkout>
#   go build -mod=readonly -trimpath -o bin/dshker-server ./cmd/dshker-server
# Default: ~/workspace/go_workspace/dshker-server/bin/dshker-server
DSHKER_SERVER_BINARY=
# A built DSH Harness checkout, needed by the two real-DSH tests. It must be
# built: apps/cli/lib/bin.js has to exist.
# Default: ~/.dshlauncher/harness
DSHKER_TEST_HARNESS_ROOT=
